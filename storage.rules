rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function conversation(conversationId) {
      return firestore.get(/databases/(default)/documents/conversations/$(conversationId)).data;
    }

    function isConversationParticipant(conversationId) {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/conversations/$(conversationId))
        && (
          conversation(conversationId).clientId == request.auth.uid
          || conversation(conversationId).coachId == request.auth.uid
        );
    }

    function allowedChatAttachment() {
      return request.resource.size < 15 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/.*')
          || request.resource.contentType.matches('text/.*')
          || request.resource.contentType.matches('application/(pdf|msword|vnd.ms-excel)')
          || request.resource.contentType.matches('application/vnd.openxmlformats-officedocument.*')
        );
    }

    match /profilePhotos/{userId}/avatar {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /chatAttachments/{conversationId}/{messageId}/{fileName} {
      allow read: if isConversationParticipant(conversationId);
      allow create, update: if isConversationParticipant(conversationId)
        && allowedChatAttachment();
      allow delete: if isConversationParticipant(conversationId);
    }
  }
}
